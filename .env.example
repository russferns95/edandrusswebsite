# ==========================================================================
# Copy to .env.local for development, and add the same keys in Vercel under
# Project -> Settings -> Environment Variables for production.
# ==========================================================================

# --- Where enquiries are delivered ----------------------------------------
# The inbox that receives every contact-form submission.
CONTACT_TO_EMAIL="info@edandruss.com"

# The address enquiries are sent FROM. It must be on a domain verified with
# your email provider, or messages will bounce or land in spam.
CONTACT_FROM_EMAIL="Ed & Russ Website <website@edandruss.com>"

# Send the enquirer an automatic acknowledgement as well ("true" to enable).
CONTACT_AUTOREPLY="false"


# --- Option A: Resend (recommended on Vercel) -----------------------------
# Create a key at https://resend.com/api-keys and verify your sending domain.
# While testing you can leave CONTACT_FROM_EMAIL unset to use Resend's sandbox
# sender, which only delivers to the address that owns the Resend account.
RESEND_API_KEY=""


# --- Option B: SMTP mailbox (Zoho, Google Workspace, Microsoft 365, ...) ---
# Used only when RESEND_API_KEY is empty. Port 465 implies TLS; 587 uses
# STARTTLS. Use an app-specific password, never the account password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"


# --- Site ------------------------------------------------------------------
# Canonical URL, used for metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL="https://www.edandruss.com"
